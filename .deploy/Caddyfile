:80 {
    root * /var/www/html/public
    encode zstd gzip

    @hiddenFiles path_regexp hidden ^/\.(?!well-known/)
    respond @hiddenFiles 404

    @sensitiveFiles path /composer.json /composer.lock /package.json /package-lock.json /phpunit.xml /vite.config.js /artisan /.env /.env.*
    respond @sensitiveFiles 404

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
    }

    @https header X-Forwarded-Proto https
    header @https Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    php_fastcgi 127.0.0.1:9000
    file_server
}
